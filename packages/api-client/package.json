{
  "name": "@galpon/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./mock": "./src/mock/index.ts",
    "./mock/card-token": "./src/mock/card-token.ts",
    "./mock/session-cookie": "./src/mock/session-cookie.ts"
  },
  "scripts": {
    "api:generate": "npx --yes openapi-typescript@7.13.0 ../../docs/api/openapi.yaml -o src/generated/schema.d.ts --root-types --root-types-no-schema-prefix --alphabetize",
    "api:check": "npx --yes openapi-typescript@7.13.0 ../../docs/api/openapi.yaml -o src/generated/schema.d.ts --root-types --root-types-no-schema-prefix --alphabetize --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@galpon/domain": "*",
    "@galpon/schemas": "*",
    "openapi-fetch": "0.17.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.4",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@tanstack/react-query": "5.104.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
