# Variables de entorno de la tienda. Copiá este archivo a `.env.local` (en esta carpeta) y ajustá
# lo que haga falta. Sin ningún archivo, la tienda arranca en modo de prueba con estos valores.
# Se validan al arrancar, al compilar y en `next dev`: si algo está mal, el comando falla con un
# mensaje en español que dice qué variable corregir.
#
# Los rewrites y las cabeceras de seguridad se fijan en el build: cambiar una variable obliga a
# volver a compilar (`npm run build`). Las que empiezan con NEXT_PUBLIC_ llegan al navegador.

# Modo de la API. `mock` (por defecto mientras se desarrolla): la tienda usa la API simulada del
# front, sin backend. `live`: habla con el backend real (ver API_BASE_URL).
# En producción (`next build` y `next start`, con NODE_ENV=production) es obligatoria: sin ella la
# tienda no arranca. `mock` en producción solo pasa con MOCK_ALLOWED_IN_PRODUCTION=true.
API_MODE=mock

# Lo que ve el navegador del modo de la API. Tiene que ser igual a API_MODE (si no se define,
# toma ese valor): así el navegador no queda en un modo distinto al del servidor.
NEXT_PUBLIC_API_MODE=mock

# Origen del backend, sin ruta. Solo se usa con API_MODE=live, donde es obligatoria: el servidor lo
# consulta directo y `/api/v1/*` se reescribe hacia él (el navegador habla siempre con la tienda).
# En modo de prueba se ignora. En la compu, el backend (NestJS) corre en http://localhost:3001; en
# producción, por ejemplo https://api.galponmates.com.ar.
# API_BASE_URL=http://localhost:3001

# ── Backend local ───────────────────────────────────────────────────────────────────────────────
# Para usar el backend que corre en http://localhost:3001: copiá este archivo a `.env.local`,
# descomentá estas líneas (y las de REVALIDATE_SECRET y NEXT_PUBLIC_MP_PUBLIC_KEY de abajo, con
# valores reales) y reiniciá `npm run dev`.
# API_MODE=live
# NEXT_PUBLIC_API_MODE=live
# API_BASE_URL=http://localhost:3001

# Secreto compartido con el backend para `POST /api/revalidate` (cabecera `x-revalidate-secret`).
# Con API_MODE=live es obligatorio y tiene que tener 32 caracteres o más (por ejemplo, el resultado
# de `openssl rand -hex 32`). En modo de prueba tiene un valor de desarrollo.
# REVALIDATE_SECRET=

# Clave pública de Mercado Pago (la usa el navegador para los campos de la tarjeta). Obligatoria
# con API_MODE=live; en modo de prueba no hace falta porque el pago es simulado.
# NEXT_PUBLIC_MP_PUBLIC_KEY=

# Cuenta de Cloudinary de donde salen las fotos de los productos (letras, números, guiones y
# guiones bajos). Opcional por ahora.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Dirección pública de la tienda, sin ruta. Se usa para las URL absolutas (SEO, sitemap) y, en el
# servidor, como base del cliente del navegador. Por defecto http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para las pruebas de punta a punta: deja que un servidor de producción (`next start`) corra con
# API_MODE=mock. Es inseguro (la API simulada no tiene autenticación real y todos los que la visitan
# comparten una sola base) y el arranque lo avisa en el log. Nunca en un sitio público.
# MOCK_ALLOWED_IN_PRODUCTION=true

# Contraseña del admin de la API simulada de la tienda (`/api/v1/admin/*`): de 10 a 128 caracteres,
# con letras y números. Sin ella, fuera de producción vale la de fábrica (README raíz) y en
# producción el admin de la API simulada queda cerrado. Solo en modo de prueba.
# MOCK_ADMIN_PASSWORD=

# Secreto de las rutas de control de la API simulada (`/api/v1/__mock/orders/…/expire` y
# `/api/v1/__mock/products/…`), de 32 caracteres o más. Con `next dev` andan sin él; en producción
# (`next start`) solo responden con este secreto en la cabecera X-Mock-Control-Secret y, sin la
# variable, responden 404. Los E2E lo ponen solos (`e2e/support/mock-controls.ts`).
# MOCK_CONTROL_SECRET=

# Cabecera donde el proxy de la plataforma (CDN o balanceador delante de la tienda) escribe la IP
# real del cliente, pisando la que mande el navegador; por ejemplo cf-connecting-ip con Cloudflare.
# El proxy de la tienda borra x-forwarded-for, x-real-ip y forwarded del cliente en /api/v1/* y, si
# esta variable está, pone x-forwarded-for con el valor de esa cabecera. En el backend, TRUST_PROXY
# tiene que listar la IP del servidor de la tienda para que tome la IP del cliente de ahí (ver el
# README del back, "Proxies de confianza"). Sin esta variable no se manda ninguna IP del cliente.
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip

# Latencia que simula la API de prueba, en milisegundos: un rango ("150-400", por defecto), un valor
# fijo ("200") o "0" para responder sin demora (útil para medir rendimiento).
MOCK_LATENCY_MS=150-400
