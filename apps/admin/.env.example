# Variables del dashboard (Vite). Copiá este archivo a .env.local para cambiarlas.
# Se validan al arrancar (src/lib/env.ts); al navegador solo llegan las que empiezan con VITE_.

# Modo de la API: "mock" (sin backend, valor por defecto) o "live" (API real).
VITE_API_MODE=mock

# URL de la API, sin /api/v1. Obligatoria con VITE_API_MODE=live. En la compu, el backend (NestJS)
# corre en http://localhost:3001; en producción, por ejemplo https://api.galponmates.com.ar.
# El dashboard le habla directo desde el navegador (con cookies), así que el backend tiene que
# aceptar CORS con credenciales desde http://localhost:5173.
VITE_API_BASE_URL=

# ── Backend local ──────────────────────────────────────────────────────────────────────────────
# Para usar el backend que corre en http://localhost:3001: copiá este archivo a .env.local,
# descomentá estas dos líneas y reiniciá `npm run dev:admin`.
# VITE_API_MODE=live
# VITE_API_BASE_URL=http://localhost:3001

# URL de la tienda, para los enlaces del dashboard.
VITE_STORE_URL=http://localhost:3000

# Solo modo de prueba: cuenta del administrador y demora simulada de la API
# (un número en milisegundos, "0" para no esperar, o un rango como "150-400").
VITE_MOCK_ADMIN_EMAIL=admin@galponmates.com.ar
VITE_MOCK_ADMIN_PASSWORD=galpon-demo-2026
VITE_MOCK_LATENCY_MS=150-400
