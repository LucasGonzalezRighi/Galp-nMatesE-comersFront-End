# Servidor interno del dashboard dentro de su imagen (ver `Dockerfile`): sirve los archivos
# compilados en el puerto 80, sin HTTPS (lo pone el proxy de entrada).
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	# CSP y demás cabeceras de seguridad: las arma `scripts/admin-caddy-headers.mjs` al construir
	# la imagen, a partir de `src/lib/csp.ts`.
	import /etc/caddy/cabeceras.caddy

	# Los archivos de `/assets` llevan un hash en el nombre: se pueden guardar para siempre.
	# El resto (el `index.html`) se vuelve a pedir siempre, así una versión nueva se ve enseguida.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@pagina not path /assets/*
	header @pagina Cache-Control "no-cache"

	# Es una SPA: cualquier ruta que no sea un archivo devuelve `index.html`.
	try_files {path} /index.html
	file_server
}
